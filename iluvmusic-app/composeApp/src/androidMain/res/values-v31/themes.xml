<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ specific splash screen theme -->
    <style name="Theme.ILuvMusic.Splash" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Android 12+ SplashScreen API attributes -->
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/iluvmusic_banner</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/iluvmusic_banner</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_bg</item>
        
        <!-- Status bar styling -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash screen theme using Android 12+ SplashScreen API -->
    <style name="Theme.ILuvMusic.Splash" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Android 12+ attributes -->
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/iluvmusic_banner</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@android:style/Theme.Material.Light.NoActionBar</item>
        
        <!-- Status bar and navigation bar styling -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
    </style>
</resources>
